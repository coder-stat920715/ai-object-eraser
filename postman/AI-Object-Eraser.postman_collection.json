    {
      "name": "3. Asynchronous erase + SSE",
      "item": [
        {
          "name": "Create async job (polls until done)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202 Accepted\", () => pm.response.to.have.status(202));",
                  "const job = pm.response.json();",
                  "pm.test(\"Job payload has jobId, streamUrl, resultUrl\", () => { pm.expect(job.jobId).to.be.a(\"string\"); pm.expect(job.streamUrl).to.include(\"/api/v1/erase/stream/\"); pm.expect(job.resultUrl).to.include(\"/api/v1/erase/result/\"); });",
                  "pm.collectionVariables.set(\"jobId\", job.jobId);",
                  "// Poll the result endpoint until the job finishes (409 = still running).",
                  "const url = pm.variables.replaceIn(\"{{baseUrl}}\") + job.resultUrl;",
                  "let tries = 0;",
                  "const check = () => pm.sendRequest(url, (err, res) => {",
                  "  if (!err && res.code === 200) { pm.test(\"Async job finished and result is PNG\", () => pm.expect(res.headers.get(\"Content-Type\")).to.include(\"image/png\")); return; }",
                  "  if (++tries < 40) setTimeout(check, 250);",
                  "  else pm.test(\"Async job finished within 10 s\", () => pm.expect.fail(\"timed out, last status \" + (res && res.code)));",
                  "});",
                  "check();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/erase/async",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "erase",
                "async"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "samples/photo.png"
                },
                {
                  "key": "mask",
                  "type": "file",
                  "src": "samples/mask.png"
                }
              ]
            },
            "description": "Saves jobId into the collection variable and polls the result endpoint from the test script."
          }
        },
        {
          "name": "Stream job progress (SSE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is text/event-stream\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\"));",
                  "const t = pm.response.text();",
                  "pm.test(\"Replays progress events\", () => pm.expect(t).to.include(\"event:progress\"));",
                  "pm.test(\"Ends with complete event\", () => pm.expect(t).to.include(\"event:complete\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/erase/stream/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "erase",
                "stream",
                "{{jobId}}"
              ]
            },
            "description": "Run after \"Create async job\". For a finished job the whole history is replayed and the stream closes. For live viewing: New > SSE request (Postman 10.17+) or use curl -N."
          }
        },
        {
          "name": "Fetch async result",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is image/png\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"image/png\"));",
                  "pm.test(\"PNG signature present\", () => { const b = new Uint8Array(pm.response.stream); pm.expect(Array.from(b.slice(1,4))).to.eql([80,78,71]); });",
                  "pm.test(\"Provider header present\", () => pm.expect(pm.response.headers.get(\"X-Eraser-Provider\")).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/erase/result/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "erase",
                "result",
                "{{jobId}}"
              ]
            }
          }
        }
      ]
